# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais committer .env.

# --- Fournisseur LLM (résumé / suggestion) : groq | ollama ---
LLM_PROVIDER=groq
# Repli si le principal échoue durablement : ollama, ou vide = pas de repli
LLM_FALLBACK_PROVIDER=

# Groq (free tier, API compatible OpenAI)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Délai maximal d'une requête, en secondes (un délai dépassé n'est pas réessayé)
GROQ_TIMEOUT_SECONDS=30

# Ollama (local, secours)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b
# Plus long que Groq : un modèle local sur CPU est lent
OLLAMA_TIMEOUT_SECONDS=120

# Gestion des erreurs 429
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=2
LLM_BACKOFF_MAX_SECONDS=30

# --- Base de données PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- API du projet ---
API_SECRET_KEY=

# --- GLPI (infra/glpi/docker-compose.yml) ---
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=
GLPI_DB_ROOT_PASSWORD=
# Ports exposés sur 127.0.0.1 uniquement
GLPI_HTTP_PORT=8082
GLPI_DB_HOST_PORT=3307

# --- API v2 de GLPI : injection des tickets générés (Issue #52, docs/glpi.md) ---
# Adresse de l'API (sans /v2 final), client OAuth "Password" et utilisateur d'API dédié
GLPI_API_URL=http://127.0.0.1:8082/api.php
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_API_USER=
GLPI_API_PASSWORD=

# --- Extraction SQL de GLPI (Issue #53, docs/donnees/glpi-extraction-sql.md) ---
# Compte MariaDB en lecture seule, créé par scripts/create_glpi_reader.py
GLPI_DB_READER_USER=
GLPI_DB_READER_PASSWORD=
# Hôte du compte en lecture seule (facultatif, 127.0.0.1 par défaut)
GLPI_DB_READER_HOST=

# Clé de pseudonymisation (HMAC-SHA256) : 32 caractères au minimum (la procédure en génère 64).
# La générer une fois (docs/glpi.md), la sauvegarder hors du dépôt : la perdre change tous les pseudonymes.
PSEUDONYMIZATION_KEY=
