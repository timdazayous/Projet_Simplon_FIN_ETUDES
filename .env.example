# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais committer .env.

# --- Fournisseur LLM (résumé / suggestion) : groq | ollama ---
LLM_PROVIDER=groq

# Groq (free tier, API compatible OpenAI)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# Ollama (local, secours)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Gestion des erreurs 429
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=2

# --- Base de données PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- API du projet ---
API_SECRET_KEY=
